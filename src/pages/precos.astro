---
import Layout from '../layouts/Layout.astro';



const plans = [
  {
    name: 'Essencial',
    description: 'Para casamentos íntimos que querem um toque digital elegante.',
    features: [
      'Convite animado com selo de cera',
      'Hero com foto do casal',
      'Countdown ao vivo',
      'Informação de cerimónia e festa',
      'Timeline do dia',
      'RSVP básico (sem acompanhantes)',
      'FAQ personalizável',
      'Contactos',
      'Tema claro/escuro',
      'Domínio personalizado',
      'Suporte por email',
    ],
    highlighted: false,
  },
  {
    name: 'Premium',
    description: 'A experiência completa para casamentos que querem impressionar.',
    features: [
      'Tudo do plano Essencial',
      'Quiz pessoal (controlo de acesso)',
      'Galeria de fotos ao vivo',
      'Mapa de mesas interativo',
      'RSVP com acompanhantes e alergias',
      'Ementa completa',
      'Dress code',
      'Love story com galeria',
      'Lista de presentes / Lua-de-mel',
      'Painel de administração',
      'Moderação de fotos',
      'Check-in de convidados',
      'Exportação CSV',
      'Suporte por WhatsApp no dia',
    ],
    highlighted: true,
  },
  {
    name: 'À Medida',
    description: 'Para casamentos com necessidades especiais ou funcionalidades extra.',
    features: [
      'Tudo do plano Premium',
      'Design totalmente personalizado',
      'Funcionalidades à medida',
      'Integrações especiais',
      'Website bilingue',
      'Suporte prioritário',
      'Reuniões de acompanhamento',
      'Alterações ilimitadas',
    ],
    highlighted: false,
  },
];

const faqs = [
  { q: 'Quanto tempo demora a criar o website?', a: 'Normalmente entre 3 a 5 semanas após recebermos todos os conteúdos (textos, fotos, detalhes do evento). Projetos mais complexos podem demorar até 2 meses.' },
  { q: 'Preciso de conhecimentos técnicos?', a: 'Não! Nós tratamos de tudo. Vocês só precisam de nos enviar os conteúdos e preferências tais como textos, fotos, cores e detalhes do evento.' },
  { q: 'Posso fazer alterações depois?', a: 'Claro! Incluímos revisões no processo. Alterações menores após entrega são incluídas. Alterações adicionais maiores têm um custo simbólico.' },
  { q: 'E se precisar de ajuda no dia do casamento?', a: 'No plano Premium, oferecemos suporte por WhatsApp no dia do evento para qualquer questão técnica como na galeria, mapa de mesas, check-in, etc.' },
  { q: 'Aceitam pagamento em prestações?', a: 'Sim! Podem pagar 50% no início e 50% na entrega final. Para o plano À Medida, podemos definir condições personalizadas.' },
  { q: 'Como funciona a reunião gratuita?', a: 'Agendamos uma videochamada onde mostramos a demo completa já preparada, com todas as funcionalidades a funcionar ao vivo. Veem o produto real, fazem perguntas e decidem sem qualquer compromisso.' },
  { q: 'Os dados dos convidados estão seguros?', a: 'Sim. Usamos Supabase com infraestrutura na UE, encriptação em trânsito (HTTPS) e não partilhamos dados com terceiros. Cumpre o RGPD.' },
];
---

<Layout title="Planos | Nó Digital" description="Descubra o plano ideal para o vosso website de casamento. Peçam um orçamento personalizado e sem compromisso.">
  <!-- Hero -->
  <section class="section-padding pt-32 text-center relative overflow-hidden">
    <!-- Background decorations -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-[15%] right-[5%] text-4xl opacity-10 float-diagonal">🌸</div>
      <div class="absolute bottom-[20%] left-[8%] text-3xl opacity-10 float">🌺</div>
      <svg class="absolute top-20 left-10 w-32 h-32 opacity-[0.04] sway" viewBox="0 0 100 100" fill="#a9b06f">
        <circle cx="50" cy="25" r="15"/><circle cx="70" cy="45" r="15"/><circle cx="60" cy="70" r="15"/><circle cx="35" cy="70" r="15"/><circle cx="30" cy="45" r="15"/><circle cx="50" cy="48" r="12"/>
      </svg>
    </div>

    <div class="max-w-3xl mx-auto animate-on-scroll relative">
      <div class="flex items-center justify-center gap-3 mb-4">
        <div class="h-px w-16 bg-gradient-to-r from-transparent to-gold-300"></div>
        <span class="text-2xl bloom">💎</span>
        <div class="h-px w-16 bg-gradient-to-l from-transparent to-gold-300"></div>
      </div>
      <p class="text-gold-500 font-medium text-sm uppercase tracking-wide mb-3">✨ Planos ✨</p>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-olive-900 mb-4">
        Encontrem o plano <span class="text-gradient-gold">ideal</span>
      </h1>
      <p class="text-olive-600 text-lg leading-relaxed">
        Cada casamento é único, por isso cada orçamento é personalizado. 
        Escolham o plano que faz sentido e peçam uma proposta à medida, sem compromisso. 🌹
      </p>
    </div>
  </section>

  <!-- Pricing Cards -->
  <section class="section-padding pt-8">
    <div class="max-w-7xl mx-auto grid md:grid-cols-3 gap-8 items-start stagger-children">
      {plans.map((plan) => (
        <div class={`rounded-3xl p-8 border relative overflow-hidden hover:-translate-y-3 transition-all duration-500 ${
          plan.highlighted
            ? 'bg-olive-900 border-gold-400 text-white shadow-2xl md:scale-105'
            : 'bg-white border-beige-200 shadow-sm hover:shadow-2xl hover:border-gold-200'
        }`}>
          {plan.highlighted && (
            <span class="absolute -top-1 left-1/2 -translate-x-1/2 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider bg-gradient-to-r from-gold-400 to-gold-500 text-olive-900 px-5 py-1.5 rounded-full shadow-lg">
              <span class="heartbeat">⭐</span> Mais Popular
            </span>
          )}
          {/* Corner flower on highlighted */}
          {plan.highlighted && (
            <svg class="absolute -top-3 -right-3 w-16 h-16 text-gold-400 opacity-20 bloom" viewBox="0 0 30 30" fill="currentColor">
              <circle cx="15" cy="8" r="4"/><circle cx="21" cy="13" r="4"/><circle cx="19" cy="20" r="4"/><circle cx="11" cy="20" r="4"/><circle cx="9" cy="13" r="4"/><circle cx="15" cy="14" r="3"/>
            </svg>
          )}
          
          <h3 class={`font-serif text-2xl font-bold mb-1 ${plan.highlighted ? 'text-white' : 'text-olive-900'}`}>
            {plan.name}
          </h3>
          <p class={`text-sm mb-4 ${plan.highlighted ? 'text-beige-300' : 'text-olive-500'}`}>
            {plan.description}
          </p>
          <div class="mb-6">
            <span class={`font-serif text-xl font-bold ${plan.highlighted ? 'text-gold-400' : 'text-gold-500'}`}>
              Pedir Orçamento
            </span>
          </div>

          <ul class="space-y-3 mb-8">
            {plan.features.map((f) => (
              <li class={`flex items-start gap-2 text-sm ${plan.highlighted ? 'text-beige-200' : 'text-olive-600'}`}>
                <span class="text-gold-400 mt-0.5 flex-shrink-0">✓</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <a
            href="/contacto"
            class={`block text-center py-4 rounded-full font-semibold transition-all duration-300 hover:-translate-y-1 ${
              plan.highlighted
                ? 'bg-gradient-to-r from-gold-400 to-gold-500 hover:from-gold-500 hover:to-gold-600 text-olive-900 shadow-lg hover:shadow-xl'
                : 'border-2 border-gold-500 text-gold-600 hover:bg-gold-500 hover:text-white hover:shadow-lg'
            }`}
          >
            Pedir Orçamento
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12 animate-on-scroll">
        <h2 class="font-serif text-3xl font-bold text-olive-900">
          Perguntas Frequentes
        </h2>
      </div>

      <div class="space-y-3">
        {faqs.map((faq) => (
          <div class="border border-beige-200 rounded-xl overflow-hidden bg-white">
            <button
              class="faq-btn w-full flex items-center justify-between px-6 py-5 text-left hover:bg-beige-50 transition-colors"
              aria-expanded="false"
              type="button"
            >
              <span class="font-medium text-olive-800 pr-4">{faq.q}</span>
              <span class="text-gold-500 text-2xl flex-shrink-0 faq-icon transition-transform duration-300" aria-hidden="true">+</span>
            </button>
            <div class="faq-content hidden px-6 pb-5">
              <p class="text-olive-600 leading-relaxed">{faq.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-gradient-to-br from-olive-900 to-olive-950 text-center relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-[15%] left-[8%] text-3xl opacity-5 float">🌸</div>
      <div class="absolute bottom-[20%] right-[8%] text-3xl opacity-5 float-diagonal">🌺</div>
      <svg class="absolute bottom-10 left-10 w-28 h-28 opacity-[0.04] sway" viewBox="0 0 100 100" fill="#d99b1a">
        <circle cx="50" cy="25" r="15"/><circle cx="70" cy="45" r="15"/><circle cx="60" cy="70" r="15"/><circle cx="35" cy="70" r="15"/><circle cx="30" cy="45" r="15"/><circle cx="50" cy="48" r="12"/>
      </svg>
    </div>

    <div class="max-w-2xl mx-auto animate-on-scroll relative">
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="h-px w-12 bg-gradient-to-r from-transparent to-gold-400/40"></div>
        <span class="text-2xl heartbeat">💐</span>
        <div class="h-px w-12 bg-gradient-to-l from-transparent to-gold-400/40"></div>
      </div>
      <h2 class="font-serif text-3xl font-bold text-white mb-4">Vamos começar? 🌹</h2>
      <p class="text-beige-300 mb-8">
        Enviem-nos uma mensagem e respondemos em menos de 24 horas com uma proposta à medida.
      </p>
      <a href="/contacto" class="btn-floral pulse-glow">
        Pedir Orçamento Grátis
      </a>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('.faq-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector('.faq-icon') as HTMLElement;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Close all others
      document.querySelectorAll('.faq-btn').forEach((other) => {
        if (other !== btn) {
          other.setAttribute('aria-expanded', 'false');
          (other.nextElementSibling as HTMLElement)?.classList.add('hidden');
          const otherIcon = other.querySelector('.faq-icon') as HTMLElement;
          if (otherIcon) { otherIcon.textContent = '+'; otherIcon.style.transform = ''; }
        }
      });

      if (isOpen) {
        btn.setAttribute('aria-expanded', 'false');
        content?.classList.add('hidden');
        if (icon) { icon.textContent = '+'; icon.style.transform = ''; }
      } else {
        btn.setAttribute('aria-expanded', 'true');
        content?.classList.remove('hidden');
        if (icon) { icon.textContent = '−'; icon.style.transform = 'rotate(180deg)'; }
      }
    });
  });
</script>
