---
import Layout from '../layouts/Layout.astro';


---

<Layout title="Contacto — Nó Digital" description="Peça um orçamento gratuito para o vosso website de casamento. Resposta em menos de 24 horas.">
  <!-- Hero -->
  <section class="section-padding pt-32">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-start">
      <!-- Left: Info -->
      <div class="animate-on-scroll-left">
        <p class="text-gold-500 font-medium text-sm uppercase tracking-wide mb-2">Contacto</p>
        <h1 class="font-serif text-4xl sm:text-5xl font-bold text-olive-900 mb-6">
          Vamos criar algo bonito juntos
        </h1>
        <p class="text-olive-600 text-lg leading-relaxed mb-10">
          Agendem uma demo gratuita e sem compromisso, mostramos o produto completo já preparado, 
          com todas as funcionalidades a funcionar ao vivo. Decidem sem pressão.
        </p>

        <div class="space-y-6">
          <div class="flex items-start gap-4 group">
            <span class="text-2xl group-hover:scale-110 transition-transform">📧</span>
            <div>
              <p class="font-medium text-olive-800">Email</p>
              <a href="mailto:hugosilva2320@gmail.com" class="text-gold-500 hover:text-gold-600 transition-colors">
                hugosilva2320@gmail.com
              </a>
            </div>
          </div>
          <div class="flex items-start gap-4 group">
            <span class="text-2xl group-hover:scale-110 transition-transform">📱</span>
            <div>
              <p class="font-medium text-olive-800">WhatsApp</p>
              <a href="https://wa.me/351911820236" class="text-gold-500 hover:text-gold-600 transition-colors">
                +351 911 820 236
              </a>
              <p class="text-olive-400 text-xs mt-0.5">Resposta rápida por mensagem</p>
            </div>
          </div>
          <div class="flex items-start gap-4 group">
            <span class="text-2xl group-hover:scale-110 transition-transform">📍</span>
            <div>
              <p class="font-medium text-olive-800">Localização</p>
              <p class="text-olive-600">Porto, Portugal</p>
              <p class="text-olive-400 text-xs mt-0.5">Trabalho remotamente com casais em todo o país</p>
            </div>
          </div>
          <div class="flex items-start gap-4 group">
            <span class="text-2xl group-hover:scale-110 transition-transform">⏰</span>
            <div>
              <p class="font-medium text-olive-800">Tempo de resposta</p>
              <p class="text-olive-600">Menos de 24 horas</p>
              <p class="text-olive-400 text-xs mt-0.5">Normalmente respondo no próprio dia</p>
            </div>
          </div>
        </div>

        <!-- Trust badges -->
        <div class="mt-10 pt-8 border-t border-beige-200">
          <p class="text-olive-500 text-sm font-medium mb-3">O que podem esperar:</p>
          <div class="flex flex-wrap gap-2">
            {['Demo completa grátis', 'Sem compromisso', 'Resposta em 24h', 'Pagamento 50/50'].map((badge) => (
              <span class="text-xs bg-beige-100 text-olive-600 px-3 py-1.5 rounded-full border border-beige-200">
                ✓ {badge}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="bg-white rounded-2xl p-8 shadow-xl border border-beige-200 animate-on-scroll-right">
        <h2 class="font-serif text-2xl font-bold text-olive-900 mb-2">Pedir Orçamento</h2>
        <p class="text-olive-500 text-sm mb-6">Todos os campos com * são obrigatórios.</p>

        <form id="contact-form" class="space-y-5" novalidate>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-sm font-medium text-olive-700 mb-1">Nome *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="w-full px-4 py-3 rounded-xl border border-beige-200 bg-beige-50 text-olive-800 
                       focus:border-gold-400 focus:ring-2 focus:ring-gold-100 focus:outline-none transition-all
                       placeholder:text-olive-400"
                placeholder="O vosso nome"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-olive-700 mb-1">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="w-full px-4 py-3 rounded-xl border border-beige-200 bg-beige-50 text-olive-800 
                       focus:border-gold-400 focus:ring-2 focus:ring-gold-100 focus:outline-none transition-all
                       placeholder:text-olive-400"
                placeholder="email@exemplo.pt"
              />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="phone" class="block text-sm font-medium text-olive-700 mb-1">Telemóvel</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                autocomplete="tel"
                class="w-full px-4 py-3 rounded-xl border border-beige-200 bg-beige-50 text-olive-800 
                       focus:border-gold-400 focus:ring-2 focus:ring-gold-100 focus:outline-none transition-all
                       placeholder:text-olive-400"
                placeholder="+351 9XX XXX XXX"
              />
            </div>
            <div>
              <label for="date" class="block text-sm font-medium text-olive-700 mb-1">Data do casamento</label>
              <input
                type="date"
                id="date"
                name="date"
                class="w-full px-4 py-3 rounded-xl border border-beige-200 bg-beige-50 text-olive-800 
                       focus:border-gold-400 focus:ring-2 focus:ring-gold-100 focus:outline-none transition-all"
              />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="guests" class="block text-sm font-medium text-olive-700 mb-1">Nº de convidados (aprox.)</label>
              <select
                id="guests"
                name="guests"
                class="w-full px-4 py-3 rounded-xl border border-beige-200 bg-beige-50 text-olive-800 
                       focus:border-gold-400 focus:ring-2 focus:ring-gold-100 focus:outline-none transition-all"
              >
                <option value="">Selecionar...</option>
                <option value="<50">Menos de 50</option>
                <option value="50-100">50 a 100</option>
                <option value="100-200">100 a 200</option>
                <option value="200+">Mais de 200</option>
              </select>
            </div>
            <div>
              <label for="plan" class="block text-sm font-medium text-olive-700 mb-1">Plano de interesse</label>
              <select
                id="plan"
                name="plan"
                class="w-full px-4 py-3 rounded-xl border border-beige-200 bg-beige-50 text-olive-800 
                       focus:border-gold-400 focus:ring-2 focus:ring-gold-100 focus:outline-none transition-all"
              >
                <option value="">Selecionar...</option>
                <option value="essencial">Essencial</option>
                <option value="premium">Premium</option>
                <option value="medida">À Medida</option>
                <option value="indeciso">Ainda não sei</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-olive-700 mb-1">Mensagem *</label>
            <textarea
              id="message"
              name="message"
              required
              rows="4"
              class="w-full px-4 py-3 rounded-xl border border-beige-200 bg-beige-50 text-olive-800 
                     focus:border-gold-400 focus:ring-2 focus:ring-gold-100 focus:outline-none transition-all 
                     resize-none placeholder:text-olive-400"
              placeholder="Contem-nos sobre o vosso casamento — local, estilo, o que imaginam para o website..."
            ></textarea>
          </div>

          <button type="submit" id="submit-btn" class="btn-primary w-full text-lg py-4">
            <span id="btn-text">Enviar Pedido →</span>
            <span id="btn-loading" class="hidden">
              <svg class="animate-spin h-5 w-5 inline mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              A enviar...
            </span>
          </button>

          <div id="form-feedback" class="hidden text-center p-4 rounded-xl" role="alert"></div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback') as HTMLElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLElement;
  const btnLoading = document.getElementById('btn-loading') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Show loading state
    submitBtn.disabled = true;
    btnText.classList.add('hidden');
    btnLoading.classList.remove('hidden');
    feedback.classList.add('hidden');

    const data = new FormData(form);

    // Basic validation
    const name = data.get('name') as string;
    const email = data.get('email') as string;
    const message = data.get('message') as string;

    if (!name?.trim() || !email?.trim() || !message?.trim()) {
      feedback.className = 'text-center p-4 rounded-xl bg-red-50 text-red-700 border border-red-200';
      feedback.textContent = 'Por favor, preencha todos os campos obrigatórios.';
      feedback.classList.remove('hidden');
      submitBtn.disabled = false;
      btnText.classList.remove('hidden');
      btnLoading.classList.add('hidden');
      return;
    }

    try {
      const { error } = await supabase.from('contacts').insert({
        name: name.trim(),
        email: email.trim(),
        phone: (data.get('phone') as string)?.trim() || null,
        wedding_date: (data.get('date') as string) || null,
        guest_count: (data.get('guests') as string) || null,
        plan: (data.get('plan') as string) || null,
        message: message.trim(),
      });

      if (error) {
        throw error;
      }

      feedback.className = 'text-center p-4 rounded-xl bg-green-50 text-green-700 border border-green-200';
      feedback.innerHTML = '✅ <strong>Mensagem enviada com sucesso!</strong><br><span class="text-sm">Respondemos em menos de 24 horas.</span>';
      feedback.classList.remove('hidden');
      form.reset();
    } catch (err) {
      feedback.className = 'text-center p-4 rounded-xl bg-red-50 text-red-700 border border-red-200';
      feedback.textContent = '❌ Erro ao enviar. Tente novamente ou contacte-nos diretamente por email ou WhatsApp.';
      feedback.classList.remove('hidden');
      console.error('Form submission error:', err);
    }

    submitBtn.disabled = false;
    btnText.classList.remove('hidden');
    btnLoading.classList.add('hidden');
  });
</script>
