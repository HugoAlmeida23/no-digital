---
import Layout from '../layouts/Layout.astro';



const values = [
  { icon: '🤝', title: 'Transparência', desc: 'Sem intermediários, sem surpresas. Falam diretamente comigo do início ao fim.' },
  { icon: '🎯', title: 'Atenção ao Detalhe', desc: 'Cada animação, cada texto, cada pixel é pensado para criar a melhor experiência.' },
  { icon: '💡', title: 'Soluções Práticas', desc: 'Tecnologia ao serviço da simplicidade, sem complicações desnecessárias.' },
  { icon: '❤️', title: 'Paixão Genuína', desc: 'Acredito que o vosso dia merece uma presença digital tão especial quanto o evento.' },
];

const process = [
  { step: '01', title: 'Primeiro Contacto', desc: 'Enviam mensagem com os detalhes do casamento. Respondo em menos de 24 horas.' },
  { step: '02', title: 'Demo Gratuita', desc: 'Videochamada onde mostro a demo completa já preparada com todas as funcionalidades a funcionar. Sem compromisso.' },
  { step: '03', title: 'Proposta & Início', desc: 'Envio proposta à medida. Após aprovação, começamos com o pagamento inicial de 50%.' },
  { step: '04', title: 'Desenvolvimento', desc: 'Construo o site com os vossos conteúdos. Partilho previews para feedback.' },
  { step: '05', title: 'Revisões & Testes', desc: 'Ajustamos tudo até estarem satisfeitos. Testo em todos os dispositivos.' },
  { step: '06', title: 'Entrega & Suporte', desc: 'Site online! Suporte incluído até ao dia do casamento (e além).' },
];
---

<Layout title="Sobre — NoDigi" description="Conheça quem está por trás da NoDigi. Developer freelancer baseado no Porto, Portugal.">
  <!-- Hero -->
  <section class="section-padding pt-32">
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-5 gap-12 items-center">
        <!-- Photo -->
        <div class="md:col-span-2 animate-on-scroll-left">
          <div class="w-48 h-48 md:w-full md:h-auto md:aspect-square mx-auto rounded-2xl overflow-hidden shadow-xl border-4 border-beige-200">
            <img
              src="/images/hugo.jpeg"
              alt="Hugo Almeida — Criador da Nó Digital"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        </div>

        <!-- Text -->
        <div class="md:col-span-3 animate-on-scroll-right">
          <p class="text-gold-500 font-medium text-sm uppercase tracking-wide mb-2">Sobre</p>
          <h1 class="font-serif text-3xl sm:text-4xl font-bold text-olive-900 mb-6">
            Olá, sou o Hugo 👋
          </h1>
          <div class="space-y-4 text-olive-700 leading-relaxed">
            <p>
              Developer freelancer baseado no Porto. Além do meu trabalho na área de software, 
              crio websites de casamento porque acredito que é um extra perfeito para o vosso casamento.
            </p>
            <p>
              Depois de construir um website de casamento para um membro da família e ver a reação 
              dos convidados, percebi que havia mais casais à procura de algo elegante, acessível e prático.
            </p>
            <p>
              Falam diretamente comigo, do início ao fim, por mensagem, videochamada ou até 
              presencialmente quando necessário!
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section-padding bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12 animate-on-scroll">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-olive-900 mb-2">
          Como trabalho
        </h2>
        <p class="text-olive-500">Princípios que guiam cada projeto.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 stagger-children">
        {values.map((v) => (
          <div class="text-center p-6 rounded-2xl bg-beige-50 border border-beige-200">
            <span class="text-3xl block mb-3">{v.icon}</span>
            <h3 class="font-semibold text-olive-800 mb-1">{v.title}</h3>
            <p class="text-olive-600 text-xs leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section-padding">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12 animate-on-scroll">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-olive-900 mb-2">
          Do primeiro contacto ao site online
        </h2>
        <p class="text-olive-500">Processo simples e transparente em cada fase.</p>
      </div>

      <div class="relative">
        <!-- Vertical line -->
        <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-beige-200 hidden md:block" aria-hidden="true"></div>

        <div class="space-y-8 stagger-children">
          {process.map((p) => (
            <div class="flex gap-6 items-start">
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-gold-50 border-2 border-gold-200 flex items-center justify-center z-10">
                <span class="font-serif text-sm font-bold text-gold-500">{p.step}</span>
              </div>
              <div class="pt-2">
                <h3 class="font-semibold text-olive-800 mb-1">{p.title}</h3>
                <p class="text-olive-600 text-sm leading-relaxed">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding text-center">
    <div class="max-w-2xl mx-auto animate-on-scroll">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-olive-900 mb-4">
        Vamos conversar?
      </h2>
      <p class="text-olive-600 mb-8 leading-relaxed">
        Agendem uma demo gratuita e sem compromisso. Mostro o produto completo a funcionar ao vivo 
        e ouvimos o que imaginam para o vosso casamento.
      </p>
      <a href="/contacto" class="btn-primary text-lg px-10 py-4">
        Agendar Demo Gratuita →
      </a>
    </div>
  </section>
</Layout>
