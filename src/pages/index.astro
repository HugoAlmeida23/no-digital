---
import Layout from '../layouts/Layout.astro';



const features = [
  { icon: '✉️', title: 'Convite Animado', desc: 'Envelope interativo com selo de cera e animação cinematográfica que surpreende os convidados.' },
  { icon: '🔐', title: 'Quiz Pessoal', desc: 'Pergunta personalizada que torna o acesso exclusivo, íntimo e divertido.' },
  { icon: '📸', title: 'Galeria ao Vivo', desc: 'Fotos dos convidados em tempo real durante o evento, partilhadas com todos.' },
  { icon: '🪑', title: 'Mapa de Mesas', desc: 'Planta interativa com zoom animado — cada convidado encontra o lugar em segundos.' },
  { icon: '📋', title: 'RSVP Inteligente', desc: 'Confirmação com acompanhantes, alergias e mensagens — sem Excel.' },
  { icon: '⏱️', title: 'Countdown', desc: 'Contagem decrescente elegante com dias, horas, minutos e segundos.' },
];

const stats = [
  { value: '50+', label: 'Casamentos' },
  { value: '10k+', label: 'Convidados Encantados' },
  { value: '100%', label: 'Satisfação' },
  { value: '0€', label: 'Custos de Hosting' },
];

const steps = [
  { number: '01', title: 'Reunião', desc: 'Conversa gratuita onde mostramos a demo completa já preparada, com todas as funcionalidades a funcionar. Sem compromisso.' },
  { number: '02', title: 'Personalização', desc: 'Escolhem as secções, enviam fotos e textos. Montamos tudo à vossa medida.' },
  { number: '03', title: 'Entrega', desc: 'Site online, testado e pronto. Suporte incluído até ao dia do casamento.' },
];

const benefits = [
  { icon: '🚀', title: 'Ultrarrápido', desc: 'Site com carregamento instantâneo em qualquer dispositivo.' },
  { icon: '📱', title: 'Mobile-First', desc: '100% responsivo e desenhado para telemóvel, tablet e desktop.' },
  { icon: '♿', title: 'Acessível', desc: 'Navegável por teclado, compatível com leitores de ecrã, suporte para daltónicos, etc.' },
  { icon: '🔒', title: 'Seguro', desc: 'Dados dos convidados encriptados.' },
];
---

<Layout>
  <!-- Hero -->
  <section class="relative min-h-screen flex items-center justify-center section-padding pt-32 overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-20 left-10 w-72 h-72 bg-gold-200/30 rounded-full blur-3xl float"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-olive-200/20 rounded-full blur-3xl float" style="animation-delay: -3s;"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-beige-200/20 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-5xl mx-auto text-center">
      <p class="text-gold-500 font-medium tracking-wide uppercase text-sm mb-4 animate-on-scroll">Websites de Casamento Premium</p>
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-olive-900 leading-tight mb-6 animate-on-scroll">
        O vosso casamento merece<br />
        <span class="text-gradient">um website inesquecível</span>
      </h1>
      <p class="text-lg sm:text-xl text-olive-600 max-w-2xl mx-auto mb-10 leading-relaxed animate-on-scroll">
        Experiências digitais elegantes e interativas que encantam os vossos convidados do convite animado à galeria de fotos ao vivo.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-on-scroll">
        <a href="/contacto" class="btn-primary text-lg px-10 py-4 pulse-glow">
          Pedir Orçamento Grátis
        </a>
        <a href="/funcionalidades" class="btn-outline text-lg px-10 py-4">
          Ver Funcionalidades
        </a>
      </div>

      <!-- Trust indicators -->
      <div class="mt-12 flex flex-wrap items-center justify-center gap-6 text-sm text-olive-500 animate-on-scroll">
        <span class="flex items-center gap-1.5">✓ Resposta em 24h</span>
        <span class="flex items-center gap-1.5">✓ Acompanhamento 24/7 antes, durante e depois do casamento</span>
        <span class="flex items-center gap-1.5">✓ 100% personalizável</span>
      </div>
    </div>
  </section>

  <!-- Features Preview -->
  <section class="section-padding">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16 animate-on-scroll">
        <p class="text-gold-500 font-medium text-sm uppercase tracking-wide mb-2">Tudo incluído</p>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-olive-900 mb-4">
          Funcionalidades que fazem a diferença
        </h2>
        <p class="text-olive-600 max-w-xl mx-auto">
          Cada detalhe pensado para criar uma experiência premium para os vossos convidados.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 stagger-children">
        {features.map((f) => (
          <div class="group bg-white rounded-2xl p-8 shadow-sm border border-beige-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 hover:border-gold-200">
            <span class="text-4xl block mb-4 group-hover:scale-110 transition-transform duration-300">{f.icon}</span>
            <h3 class="font-serif text-xl font-semibold text-olive-800 mb-2">{f.title}</h3>
            <p class="text-olive-600 text-sm leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-12 animate-on-scroll">
        <a href="/funcionalidades" class="btn-outline">
          Ver todas as funcionalidades →
        </a>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section-padding bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16 animate-on-scroll">
        <p class="text-gold-500 font-medium text-sm uppercase tracking-wide mb-2">Processo Simples</p>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-olive-900 mb-4">
          Como funciona
        </h2>
        <p class="text-olive-600 max-w-xl mx-auto">
          Do primeiro contacto ao site online em menos de 2 semanas.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 stagger-children">
        {steps.map((step) => (
          <div class="relative text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gold-50 border-2 border-gold-200 mb-6">
              <span class="font-serif text-2xl font-bold text-gold-500">{step.number}</span>
            </div>
            <h3 class="font-serif text-xl font-semibold text-olive-800 mb-2">{step.title}</h3>
            <p class="text-olive-600 text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Demo / Meeting -->
  <section class="section-padding bg-olive-900">
    <div class="max-w-4xl mx-auto text-center">
      <div class="animate-on-scroll">
        <p class="text-gold-400 font-medium text-sm uppercase tracking-wide mb-2">Sem Compromisso</p>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-6">
          Na primeira reunião, mostro tudo a funcionar
        </h2>
        <p class="text-beige-300 text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
          Temos uma demo completa já preparada com todas as funcionalidades — convite animado, galeria ao vivo, 
          mapa de mesas, RSVP e tudo o resto. Na reunião gratuita, veem o produto real a funcionar 
          e decidem sem qualquer pressão. Zero compromisso.
        </p>
      </div>
      <div class="grid sm:grid-cols-3 gap-6 mb-10 stagger-children">
        <div class="bg-olive-800/50 rounded-xl p-6 border border-olive-700 hover:border-gold-500/30 transition-colors">
          <div class="text-3xl mb-3">🎥</div>
          <h3 class="font-semibold text-white mb-1">Demo Já Preparada</h3>
          <p class="text-beige-400 text-sm">Veem todas as funcionalidades a funcionar ao vivo, antes de decidirem.</p>
        </div>
        <div class="bg-olive-800/50 rounded-xl p-6 border border-olive-700 hover:border-gold-500/30 transition-colors">
          <div class="text-3xl mb-3">🧩</div>
          <h3 class="font-semibold text-white mb-1">100% Modular</h3>
          <p class="text-beige-400 text-sm">Escolhem as secções que querem. Nada é obrigatório.</p>
        </div>
        <div class="bg-olive-800/50 rounded-xl p-6 border border-olive-700 hover:border-gold-500/30 transition-colors">
          <div class="text-3xl mb-3">✨</div>
          <h3 class="font-semibold text-white mb-1">Features à Medida</h3>
          <p class="text-beige-400 text-sm">Têm uma ideia diferente? Construímos juntos.</p>
        </div>
      </div>
      <div class="animate-on-scroll">
        <a href="/contacto" class="btn-primary bg-gold-400 hover:bg-gold-500 text-lg px-10 py-4">
          Agendar Demo Gratuita →
        </a>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="section-padding">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16 animate-on-scroll">
        <p class="text-gold-500 font-medium text-sm uppercase tracking-wide mb-2">Qualidade garantida</p>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-olive-900 mb-4">
          Performance e acessibilidade
        </h2>
        <p class="text-olive-600 max-w-xl mx-auto">
          Websites rápidos, seguros e acessíveis a todos — com zero custos recorrentes.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 stagger-children">
        {benefits.map((b) => (
          <div class="text-center p-6 rounded-2xl bg-white border border-beige-200 hover:shadow-md transition-all">
            <span class="text-3xl block mb-3">{b.icon}</span>
            <h3 class="font-semibold text-olive-800 mb-1">{b.title}</h3>
            <p class="text-olive-600 text-xs leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-gradient-to-br from-olive-900 via-olive-950 to-olive-900 text-center relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-10 left-1/4 w-64 h-64 bg-gold-500/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-1/4 w-80 h-80 bg-gold-500/5 rounded-full blur-3xl"></div>
    </div>
    <div class="max-w-3xl mx-auto relative animate-on-scroll">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-4">
        Prontos para criar algo especial?
      </h2>
      <p class="text-beige-300 text-lg mb-8 leading-relaxed">
        Cada casamento é único. Vamos criar juntos o website perfeito para o vosso dia.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contacto" class="btn-primary text-lg px-10 py-4 bg-gold-400 hover:bg-gold-500">
          Pedir Orçamento Grátis →
        </a>
        <a href="/precos" class="text-beige-300 hover:text-white font-medium transition-colors text-sm underline underline-offset-4">
          Ver planos e planos
        </a>
      </div>
    </div>
  </section>
</Layout>
