---
import Layout from '../layouts/Layout.astro';

const features = [
  { icon: '✉️', title: 'Convite Animado', desc: 'Envelope interativo com selo de cera e animação cinematográfica.', emoji: '💌' },
  { icon: '📸', title: 'Galeria ao Vivo', desc: 'Fotos dos convidados em tempo real durante o evento.', emoji: '🌺' },
  { icon: '🪑', title: 'Mapa de Mesas', desc: 'Planta interativa — cada convidado encontra o lugar em segundos.', emoji: '🌷' },
  { icon: '📋', title: 'RSVP Inteligente', desc: 'Confirmação com acompanhantes e alergias.', emoji: '🌹' },
  { icon: '⏱️', title: 'Countdown', desc: 'Contagem decrescente elegante até ao grande dia.', emoji: '🌻' },
  { icon: '🔐', title: 'Quiz Pessoal', desc: 'Acesso exclusivo e divertido com pergunta personalizada.', emoji: '🌸' },
];

const stats = [
  { value: '50+', label: 'Casamentos' },
  { value: '10k+', label: 'Convidados Encantados' },
  { value: '100%', label: 'Satisfação' },
  { value: '0€', label: 'Custos de Hosting' },
];

const testimonials = [
  { name: 'Ana & Pedro', location: 'Porto', text: 'Os convidados ficaram maravilhados com o convite animado. Elogios durante meses!', flower: '🌹' },
  { name: 'Mariana & Tiago', location: 'Lisboa', text: 'A galeria ao vivo foi o ponto alto. Centenas de fotos espontâneas!', flower: '🌺' },
  { name: 'Catarina & João', location: 'Algarve', text: 'O mapa de mesas poupou-nos imenso stress. Ninguém se perdeu!', flower: '🌷' },
];

const marqueeItems = ['💐 Convites Animados', '📸 Galeria ao Vivo', '🪑 Mapa de Mesas', '📋 RSVP', '⏱️ Countdown', '🎨 100% Personalizável', '💍 Feito com Amor', '🌸 Premium', '🥂 Sem Compromisso', '🇵🇹 Feito em Portugal'];
---

<Layout>
  <!-- ===== SPLASH SCREEN ===== -->
  <div id="splash" class="splash-screen">
    <div class="splash-heart">💍</div>
    <div class="splash-text">Nó Digital</div>
    <p class="text-olive-500 text-sm mt-4 animate-pulse">A preparar algo especial...</p>
  </div>

  <!-- ===== FALLING PETALS CONTAINER ===== -->
  <div id="petals-container" class="fixed inset-0 pointer-events-none z-[99]" aria-hidden="true"></div>

  <!-- ===== WELCOME POPUP ===== -->
  <div id="welcome-popup" class="popup-overlay" role="dialog" aria-labelledby="popup-title" aria-modal="true">
    <div class="popup-content">
      <button class="popup-close" id="popup-close-btn" aria-label="Fechar">&times;</button>
      <div class="text-6xl mb-4 heartbeat">💐</div>
      <h2 id="popup-title" class="font-serif text-2xl font-bold text-olive-900 mb-3">Bem-vindos ao Nó Digital!</h2>
      <p class="text-olive-600 mb-6 leading-relaxed">
        Criamos websites de casamento que encantam. Agendem uma <strong>demo gratuita</strong> e vejam tudo a funcionar ao vivo!
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/contacto" class="btn-floral text-sm px-6 py-3">🌹 Ver Demo Grátis</a>
        <button id="popup-dismiss" class="text-olive-500 hover:text-gold-500 text-sm font-medium transition-colors cursor-pointer">
          Explorar primeiro →
        </button>
      </div>
      <!-- Decorative flowers around popup -->
      <svg class="absolute -top-6 -left-6 w-14 h-14 text-gold-300 opacity-60 bloom" viewBox="0 0 30 30" fill="currentColor">
        <circle cx="15" cy="8" r="4"/><circle cx="21" cy="13" r="4"/><circle cx="19" cy="20" r="4"/><circle cx="11" cy="20" r="4"/><circle cx="9" cy="13" r="4"/><circle cx="15" cy="14" r="3" fill="#a05614"/>
      </svg>
      <svg class="absolute -bottom-5 -right-5 w-12 h-12 text-olive-300 opacity-50 bloom" style="animation-delay: -1.5s;" viewBox="0 0 30 30" fill="currentColor">
        <circle cx="15" cy="8" r="4"/><circle cx="21" cy="13" r="4"/><circle cx="19" cy="20" r="4"/><circle cx="11" cy="20" r="4"/><circle cx="9" cy="13" r="4"/><circle cx="15" cy="14" r="3" fill="#555c31"/>
      </svg>
    </div>
  </div>

  <!-- ===== FLOATING WHATSAPP FAB ===== -->
  <a href="https://wa.me/351911820236" target="_blank" rel="noopener noreferrer" class="fab-whatsapp !w-12 !h-12 sm:!w-16 sm:!h-16" aria-label="Contactar por WhatsApp">
    <svg class="w-6 h-6 sm:w-8 sm:h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>

  <!-- ==================== HERO ==================== -->
  <section class="relative min-h-[90vh] sm:min-h-screen flex items-center justify-center overflow-hidden pt-16 sm:pt-20 pb-16 sm:pb-0">
    
    <!-- MASSIVE ANIMATED FLORAL BACKGROUND -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      
      <!-- Giant rose top-left -->
      <svg class="absolute -top-10 -left-20 w-[300px] sm:w-[500px] h-[300px] sm:h-[500px] float-slow opacity-[0.1]" viewBox="0 0 400 400" fill="none">
        <path d="M200 50 C250 80, 320 100, 340 160 C360 220, 330 290, 280 320 C230 350, 160 350, 120 320 C80 290, 50 230, 60 170 C70 110, 130 60, 200 50Z" stroke="#8d9650" stroke-width="2" fill="#8d9650" fill-opacity="0.3"/>
        <path d="M200 80 C240 100, 290 120, 300 160 C310 200, 290 250, 260 270 C230 290, 180 290, 150 270 C120 250, 100 210, 110 170 C120 130, 160 90, 200 80Z" stroke="#8d9650" stroke-width="1.5" fill="#8d9650" fill-opacity="0.2"/>
        <path d="M200 110 C230 125, 265 140, 270 165 C275 190, 260 220, 240 235 C220 250, 185 250, 165 235 C145 220, 135 195, 140 170 C145 145, 170 120, 200 110Z" fill="#a9b06f" fill-opacity="0.3"/>
        <circle cx="200" cy="180" r="30" fill="#d99b1a" fill-opacity="0.2"/>
        <circle cx="200" cy="180" r="15" fill="#d99b1a" fill-opacity="0.3"/>
      </svg>

      <!-- Giant rose bottom-right -->
      <svg class="absolute -bottom-20 -right-20 w-[350px] sm:w-[600px] h-[350px] sm:h-[600px] float opacity-[0.08]" viewBox="0 0 400 400" fill="none">
        <path d="M200 40 C260 70, 340 90, 360 160 C380 230, 340 310, 280 340 C220 370, 150 360, 100 320 C50 280, 30 210, 50 150 C70 90, 140 50, 200 40Z" stroke="#a9b06f" stroke-width="2" fill="#a9b06f" fill-opacity="0.4"/>
        <path d="M200 90 C240 110, 300 130, 310 170 C320 210, 300 260, 270 280 C240 300, 180 300, 150 280 C120 260, 100 220, 110 180 C120 140, 160 105, 200 90Z" fill="#8d9650" fill-opacity="0.3"/>
        <circle cx="200" cy="190" r="40" fill="#d99b1a" fill-opacity="0.15"/>
        <circle cx="200" cy="190" r="20" fill="#e8b832" fill-opacity="0.2"/>
      </svg>

      <!-- Floating flower clusters (hidden on mobile) -->
      <div class="hidden sm:block absolute top-[10%] right-[5%] text-4xl float-diagonal opacity-30" style="animation-delay: -2s;">🌸</div>
      <div class="hidden sm:block absolute top-[20%] left-[5%] text-3xl float opacity-25" style="animation-delay: -4s;">🌺</div>
      <div class="hidden sm:block absolute top-[40%] right-[8%] text-2xl float-slow opacity-20" style="animation-delay: -1s;">🌷</div>
      <div class="hidden sm:block absolute bottom-[30%] left-[3%] text-3xl float-diagonal opacity-25" style="animation-delay: -3s;">🌹</div>
      <div class="hidden sm:block absolute top-[60%] right-[12%] text-2xl float opacity-20" style="animation-delay: -5s;">💐</div>
      <div class="hidden sm:block absolute top-[15%] left-[40%] text-xl float-slow opacity-15" style="animation-delay: -2.5s;">🌻</div>
      <div class="hidden sm:block absolute bottom-[20%] right-[30%] text-2xl float-diagonal opacity-20" style="animation-delay: -3.5s;">🪻</div>
      <div class="hidden sm:block absolute top-[70%] left-[15%] text-xl float opacity-15" style="animation-delay: -4.5s;">🌼</div>

      <!-- Scattered petals SVG (hidden on mobile) -->
      <svg class="hidden sm:block absolute top-[15%] right-[10%] w-16 h-16 float opacity-20 sway" style="animation-delay: -2s;" viewBox="0 0 50 50" fill="#d99b1a">
        <ellipse cx="25" cy="20" rx="8" ry="15" transform="rotate(-20 25 25)"/>
      </svg>
      <svg class="hidden sm:block absolute top-[60%] left-[8%] w-12 h-12 float opacity-15 sway" style="animation-delay: -4s;" viewBox="0 0 50 50" fill="#a9b06f">
        <ellipse cx="25" cy="20" rx="6" ry="12" transform="rotate(15 25 25)"/>
      </svg>
      <svg class="hidden sm:block absolute top-[30%] left-[15%] w-10 h-10 float-slow opacity-20" style="animation-delay: -1s;" viewBox="0 0 50 50" fill="#c8ae77">
        <ellipse cx="25" cy="20" rx="5" ry="10" transform="rotate(-30 25 25)"/>
      </svg>
      <svg class="hidden sm:block absolute bottom-[25%] right-[20%] w-14 h-14 float-slow opacity-15" style="animation-delay: -5s;" viewBox="0 0 50 50" fill="#d99b1a">
        <ellipse cx="25" cy="20" rx="7" ry="13" transform="rotate(25 25 25)"/>
      </svg>

      <!-- Champagne bubbles (hidden on mobile) -->
      <div class="hidden sm:block absolute top-[20%] right-[25%] w-4 h-4 rounded-full bg-gold-300/25 float sparkle" style="animation-delay: -1s;"></div>
      <div class="hidden sm:block absolute top-[35%] right-[15%] w-3 h-3 rounded-full bg-gold-400/20 float sparkle" style="animation-delay: -3s;"></div>
      <div class="hidden sm:block absolute top-[50%] left-[20%] w-5 h-5 rounded-full bg-gold-200/20 float-slow sparkle" style="animation-delay: -2s;"></div>
      <div class="hidden sm:block absolute top-[70%] right-[35%] w-3 h-3 rounded-full bg-gold-300/25 float sparkle" style="animation-delay: -4s;"></div>
      <div class="hidden sm:block absolute bottom-[30%] left-[30%] w-4 h-4 rounded-full bg-gold-200/15 float-slow sparkle"></div>
      <div class="hidden sm:block absolute top-[25%] left-[60%] w-2 h-2 rounded-full bg-gold-400/30 float sparkle" style="animation-delay: -1.5s;"></div>
      <div class="hidden sm:block absolute top-[80%] left-[50%] w-3 h-3 rounded-full bg-gold-300/20 float sparkle" style="animation-delay: -2.5s;"></div>

      <!-- Rings interlinked (hidden on mobile) -->
      <svg class="hidden sm:block absolute top-[12%] left-[50%] -translate-x-1/2 w-28 h-28 opacity-[0.1] spin-slow" viewBox="0 0 100 100" fill="none" stroke="#d99b1a" stroke-width="3">
        <circle cx="38" cy="50" r="20"/>
        <circle cx="62" cy="50" r="20"/>
      </svg>

      <!-- More decorative elements (hidden on mobile) -->
      <svg class="hidden sm:block absolute bottom-[40%] left-[45%] w-6 h-6 opacity-20 sparkle" style="animation-delay: -1s;" viewBox="0 0 24 24" fill="#e8b832">
        <path d="M12 2L14 8L20 8L15 12L17 18L12 14L7 18L9 12L4 8L10 8Z"/>
      </svg>
      <svg class="hidden sm:block absolute top-[55%] right-[40%] w-5 h-5 opacity-15 sparkle" style="animation-delay: -3s;" viewBox="0 0 24 24" fill="#d99b1a">
        <path d="M12 2L14 8L20 8L15 12L17 18L12 14L7 18L9 12L4 8L10 8Z"/>
      </svg>

      <!-- Soft glow -->
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[400px] sm:w-[900px] h-[400px] sm:h-[900px] bg-gold-100/25 rounded-full blur-[100px] sm:blur-[150px]"></div>
      <div class="hidden sm:block absolute bottom-0 left-1/4 w-[500px] h-[500px] bg-olive-100/15 rounded-full blur-[100px]"></div>
    </div>

    <!-- CONTENT -->
    <div class="relative max-w-5xl mx-auto text-center px-4">
      <!-- Decorative rings above title (hidden on mobile) -->
      <div class="hidden sm:flex justify-center mb-6 animate-on-scroll">
        <div class="relative">
          <svg width="70" height="42" viewBox="0 0 60 36" fill="none" class="opacity-50 float-bounce">
            <circle cx="22" cy="18" r="14" stroke="#d99b1a" stroke-width="1.5"/>
            <circle cx="38" cy="18" r="14" stroke="#d99b1a" stroke-width="1.5"/>
          </svg>
          <div class="absolute -top-2 -right-4 text-sm sparkle">✨</div>
          <div class="absolute -bottom-1 -left-3 text-sm sparkle" style="animation-delay: -1s;">✨</div>
        </div>
      </div>

      <p class="text-gold-600 font-medium tracking-[0.2em] sm:tracking-[0.3em] uppercase text-xs mb-4 sm:mb-6 animate-on-scroll">
        ✿ Websites de Casamento Premium ✿
      </p>
      
      <h1 class="font-serif text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-olive-900 leading-tight mb-2 sm:mb-3 animate-on-scroll">
        O vosso casamento merece
      </h1>
      <p class="font-script text-3xl sm:text-5xl md:text-6xl text-gradient-gold mb-3 sm:mb-4 animate-on-scroll">
        um website inesquecível
      </p>
      
      <!-- Animated decorative line -->
      <div class="flex items-center justify-center gap-4 mb-6 sm:mb-8 animate-on-scroll">
        <div class="h-px w-12 sm:w-20 bg-gradient-to-r from-transparent to-gold-400 opacity-60"></div>
        <span class="text-lg sm:text-xl heartbeat">💕</span>
        <div class="h-px w-12 sm:w-20 bg-gradient-to-l from-transparent to-gold-400 opacity-60"></div>
      </div>

      <p class="text-base sm:text-xl text-olive-600 max-w-2xl mx-auto mb-8 sm:mb-12 leading-relaxed animate-on-scroll px-2">
        Experiências digitais interativas que encantam os vossos convidados — 
        do convite animado à galeria de fotos ao vivo.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5 animate-on-scroll">
        <div class="relative">
          <!-- Flowers around button (hidden on mobile) -->
          <svg class="hidden sm:block absolute -top-5 -left-5 w-10 h-10 text-gold-300 opacity-60 bloom" viewBox="0 0 30 30" fill="currentColor">
            <circle cx="15" cy="8" r="4"/><circle cx="21" cy="13" r="4"/><circle cx="19" cy="20" r="4"/><circle cx="11" cy="20" r="4"/><circle cx="9" cy="13" r="4"/><circle cx="15" cy="14" r="3" fill="#a05614"/>
          </svg>
          <svg class="hidden sm:block absolute -bottom-4 -right-4 w-8 h-8 text-olive-300 opacity-50 bloom" style="animation-delay: -1.5s;" viewBox="0 0 30 30" fill="currentColor">
            <circle cx="15" cy="8" r="3"/><circle cx="20" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><circle cx="12" cy="19" r="3"/><circle cx="10" cy="12" r="3"/><circle cx="15" cy="13" r="2.5" fill="#555c31"/>
          </svg>
          <a href="/contacto" class="btn-floral !px-7 !py-4 !text-base sm:!px-10 sm:!py-5 sm:!text-lg" id="hero-cta">
            🥂 Agendar Demo Gratuita
          </a>
        </div>

        <div class="relative">
          <a href="/funcionalidades" class="btn-floral-outline !px-7 !py-4 !text-base sm:!px-10 sm:!py-5 sm:!text-lg">
            🌸 Ver Funcionalidades
          </a>
        </div>
      </div>

      <!-- Trust pills -->
      <div class="mt-8 sm:mt-14 animate-on-scroll">
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-5">
          <span class="flex items-center gap-1.5 text-xs sm:text-sm text-olive-600 bg-white/80 backdrop-blur-sm px-3 sm:px-5 py-2 sm:py-2.5 rounded-full border border-gold-200/50 shadow-sm cursor-default">
            💐 Demo já preparada
          </span>
          <span class="flex items-center gap-1.5 text-xs sm:text-sm text-olive-600 bg-white/80 backdrop-blur-sm px-3 sm:px-5 py-2 sm:py-2.5 rounded-full border border-gold-200/50 shadow-sm cursor-default">
            💍 Sem compromisso
          </span>
          <span class="flex items-center gap-1.5 text-xs sm:text-sm text-olive-600 bg-white/80 backdrop-blur-sm px-3 sm:px-5 py-2 sm:py-2.5 rounded-full border border-gold-200/50 shadow-sm cursor-default">
            🎨 100% personalizável
          </span>
        </div>
      </div>
    </div>

    <!-- Bottom vine/branch decoration -->
    <div class="absolute bottom-0 left-0 right-0 pointer-events-none" aria-hidden="true">
      <svg class="w-full h-12 sm:h-24 text-olive-800" preserveAspectRatio="none" viewBox="0 0 1200 80" fill="currentColor">
        <path d="M0,80 L0,60 Q150,30 300,50 Q450,70 600,40 Q750,10 900,45 Q1050,80 1200,50 L1200,80 Z" opacity="0.9"/>
      </svg>
      <!-- Flowers on the vine (hidden on mobile) -->
      <svg class="hidden sm:block absolute bottom-8 left-[15%] w-6 h-6 text-gold-400 bloom" viewBox="0 0 20 20" fill="currentColor">
        <circle cx="10" cy="5" r="3"/><circle cx="14" cy="9" r="3"/><circle cx="12" cy="14" r="3"/><circle cx="7" cy="14" r="3"/><circle cx="6" cy="9" r="3"/><circle cx="10" cy="9" r="2.5" fill="#a05614"/>
      </svg>
      <svg class="hidden sm:block absolute bottom-10 left-[35%] w-5 h-5 text-gold-300 bloom" style="animation-delay: -1s;" viewBox="0 0 20 20" fill="currentColor">
        <circle cx="10" cy="5" r="2.5"/><circle cx="13" cy="8" r="2.5"/><circle cx="12" cy="13" r="2.5"/><circle cx="8" cy="13" r="2.5"/><circle cx="7" cy="8" r="2.5"/><circle cx="10" cy="9" r="2" fill="#a05614"/>
      </svg>
      <svg class="hidden sm:block absolute bottom-6 left-[55%] w-6 h-6 text-gold-400 bloom" style="animation-delay: -2s;" viewBox="0 0 20 20" fill="currentColor">
        <circle cx="10" cy="5" r="3"/><circle cx="14" cy="9" r="3"/><circle cx="12" cy="14" r="3"/><circle cx="7" cy="14" r="3"/><circle cx="6" cy="9" r="3"/><circle cx="10" cy="9" r="2.5" fill="#a05614"/>
      </svg>
      <svg class="hidden sm:block absolute bottom-9 right-[20%] w-5 h-5 text-gold-300 bloom" style="animation-delay: -0.5s;" viewBox="0 0 20 20" fill="currentColor">
        <circle cx="10" cy="5" r="2.5"/><circle cx="13" cy="8" r="2.5"/><circle cx="12" cy="13" r="2.5"/><circle cx="8" cy="13" r="2.5"/><circle cx="7" cy="8" r="2.5"/><circle cx="10" cy="9" r="2" fill="#a05614"/>
      </svg>
    </div>
  </section>

  <!-- ==================== MARQUEE BANNER ==================== -->
  <section class="bg-olive-800 py-4 overflow-hidden relative">
    <div class="marquee-container">
      <div class="marquee-content gap-8 text-beige-200 text-sm font-medium">
        {[...marqueeItems, ...marqueeItems].map((item) => (
          <span class="inline-flex items-center gap-2 px-4">{item}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== FEATURES ==================== -->
  <section class="section-padding relative overflow-hidden">
    <!-- Background florals -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <svg class="absolute top-10 right-0 w-80 h-80 opacity-[0.04] spin-reverse" viewBox="0 0 300 300" fill="#8d9650">
        <path d="M150 20 C200 50, 270 70, 280 140 C290 210, 250 270, 200 280 C150 290, 80 270, 50 220 C20 170, 40 90, 90 50 C120 30, 130 20, 150 20Z"/>
      </svg>
      <svg class="absolute bottom-20 left-0 w-64 h-64 opacity-[0.04] spin-slow" viewBox="0 0 300 300" fill="#a9b06f">
        <path d="M150 30 C200 50, 260 80, 270 150 C280 220, 240 270, 180 280 C120 290, 60 260, 40 200 C20 140, 60 70, 110 40 C130 30, 140 28, 150 30Z"/>
      </svg>
      <!-- Floating emojis -->
      <div class="absolute top-[10%] left-[5%] text-2xl float opacity-10">🌿</div>
      <div class="absolute bottom-[15%] right-[5%] text-2xl float-slow opacity-10">🍃</div>
    </div>

    <div class="max-w-7xl mx-auto relative">
      <div class="text-center mb-16 animate-on-scroll">
        <!-- Floral divider -->
        <div class="flex items-center justify-center gap-3 mb-6">
          <div class="h-px w-20 bg-gradient-to-r from-transparent to-gold-300"></div>
          <svg width="28" height="28" viewBox="0 0 30 30" fill="#d99b1a" class="opacity-60 bloom">
            <circle cx="15" cy="8" r="4"/><circle cx="21" cy="13" r="4"/><circle cx="19" cy="20" r="4"/><circle cx="11" cy="20" r="4"/><circle cx="9" cy="13" r="4"/><circle cx="15" cy="14" r="3" fill="#a05614"/>
          </svg>
          <div class="h-px w-20 bg-gradient-to-l from-transparent to-gold-300"></div>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-olive-900 mb-4">
          Funcionalidades que <span class="text-gradient-gold">encantam</span>
        </h2>
        <p class="text-olive-600 max-w-xl mx-auto">
          Cada detalhe pensado para o vosso dia especial. ✨
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 stagger-children">
        {features.map((f, i) => (
