---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;const featureGroups = [
  {
    category: 'Experiência do Convidado',
    features: [
      {
        icon: '✉️',
        title: 'Convite Animado com Selo de Cera',
        desc: 'Os convidados são recebidos com um envelope full-screen. Ao tocar, o selo dourado parte-se, o envelope abre-se e revela um cartão elegante com os nomes, data e local. Partículas douradas flutuam no fundo.',
        highlights: ['Animação cinematográfica', 'Responsivo mobile + desktop', 'Acessível por teclado'],
      },
      {
        icon: '🔐',
        title: 'Quiz Pessoal (Controlo de Acesso)',
        desc: 'Uma pergunta personalizada sobre o casal que os convidados devem responder para desbloquear o site. Adiciona um toque íntimo e exclusivo.',
        highlights: ['Pergunta personalizável', 'Feedback animado', 'Múltiplas tentativas'],
      },
      {
        icon: '📸',
        title: 'Galeria de Fotos ao Vivo',
        desc: 'Página dedicada onde os convidados carregam fotos durante o evento. As fotos aparecem instantaneamente para todos em tempo real.',
        highlights: ['Upload com compressão automática', 'Atualização em tempo real', 'Lightbox com swipe'],
      },
      {
        icon: '🪑',
        title: 'Mapa de Mesas Interativo',
        desc: 'Os convidados procuram o seu nome e veem a planta da sala com zoom animado até à sua mesa. O seu lugar é destacado a dourado.',
        highlights: ['Planta SVG interativa', 'Zoom animado suave', 'Painel com lista de convidados'],
      },
    ],
  },
  {
    category: 'Informação & Logística',
    features: [
      {
        icon: '⏱️',
        title: 'Countdown ao Vivo',
        desc: 'Contagem decrescente elegante com dias, horas, minutos e segundos. Muda automaticamente para mensagem especial no dia.',
        highlights: ['Atualização em tempo real', 'Mensagem personalizada no dia'],
      },
      {
        icon: '📍',
        title: 'Locais com Mapa',
        desc: 'Cards elegantes para cerimónia e festa com fotos, moradas e link direto para Google Maps.',
        highlights: ['Navegação com um toque', 'Fotos dos locais'],
      },
      {
        icon: '📅',
        title: 'Timeline do Dia',
        desc: 'Programa visual com horários, eventos e descrições. Layout alternado no desktop.',
        highlights: ['Design visual com linha temporal', 'Totalmente personalizável'],
      },
      {
        icon: '🍽️',
        title: 'Ementa Completa',
        desc: 'Menu organizado por categorias — entradas, pratos, sobremesas e bebidas — com descrições elegantes.',
        highlights: ['Organizado por curso', 'Tipografia premium'],
      },
    ],
  },
  {
    category: 'Gestão & Controlo',
    features: [
      {
        icon: '📋',
        title: 'RSVP com Acompanhantes',
        desc: 'Formulário completo onde convidados confirmam presença, adicionam acompanhantes (adultos/crianças) e indicam alergias.',
        highlights: ['Gestão de acompanhantes', 'Restrições alimentares', 'Mensagem para os noivos'],
      },
      {
        icon: '🎛️',
        title: 'Painel de Administração',
        desc: 'Dashboard privado para gerir convidados, mesas, fotos e check-in no dia do evento.',
        highlights: ['Lista de convidados pesquisável', 'Exportação CSV', 'Moderação de fotos'],
      },
      {
        icon: '🌙',
        title: 'Tema Claro/Escuro',
        desc: 'Os convidados podem alternar entre modo claro e escuro. O tema padrão é configurável.',
        highlights: ['Preferência guardada', 'Toggle elegante'],
      },
      {
        icon: '🚀',
        title: 'Deploy Automático',
        desc: 'Hosting gratuito no GitHub Pages com deploy automático. Zero custos mensais, velocidade máxima.',
        highlights: ['Zero custos de hosting', 'SSL automático', 'CDN global'],
      },
    ],
  },
];
---

<Layout title="Funcionalidades — Nó Digital" description="Todas as funcionalidades incluídas no vosso website de casamento premium.">
  <!-- Hero -->
  <section class="section-padding pt-32 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-gold-500 font-medium text-sm uppercase tracking-wide mb-2">Funcionalidades</p>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-olive-900 mb-4">
        Tudo o que o vosso website precisa
      </h1>
      <p class="text-olive-600 text-lg leading-relaxed">
        Cada funcionalidade foi desenhada para criar uma experiência premium — 
        para vocês e para os vossos convidados.
      </p>
    </div>
  </section>

  <!-- Feature Groups -->
  {featureGroups.map((group) => (
    <section class="section-padding">
      <div class="max-w-7xl mx-auto">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-olive-900 mb-12 text-center">
          {group.category}
        </h2>

        <div class="grid md:grid-cols-2 gap-8">
          {group.features.map((f) => (
            <div class="bg-white rounded-2xl p-8 shadow-sm border border-beige-200 hover:shadow-md transition-shadow">
              <span class="text-4xl block mb-4">{f.icon}</span>
              <h3 class="font-serif text-xl font-semibold text-olive-800 mb-3">{f.title}</h3>
              <p class="text-olive-600 leading-relaxed mb-4">{f.desc}</p>
              <ul class="space-y-1">
                {f.highlights.map((h) => (
                  <li class="text-sm text-olive-500 flex items-center gap-2">
                    <span class="text-gold-500">✓</span> {h}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- CTA -->
  <section class="section-padding bg-olive-900 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-serif text-3xl font-bold text-white mb-4">Gostaram do que viram?</h2>
      <p class="text-beige-300 mb-8">Vamos criar o website perfeito para o vosso casamento.</p>
      <a href={`${base}contacto`} class="btn-primary bg-gold-400 hover:bg-gold-500 text-lg px-10 py-4">
        Pedir Orçamento →
      </a>
    </div>
  </section>
</Layout>
