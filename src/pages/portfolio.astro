---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    couple: 'Ana & Pedro',
    location: 'Sintra',
    date: 'Setembro 2024',
    description: 'Um casamento clássico na Quinta da Regaleira com tema dourado e verde oliva. Galeria ao vivo com mais de 400 fotos partilhadas pelos convidados.',
    image: '/portfolio/ana-pedro.jpg',
    features: ['Convite animado', 'Galeria ao vivo', 'Mapa de mesas', 'RSVP'],
  },
  {
    couple: 'Mariana & Tiago',
    location: 'Porto',
    date: 'Junho 2024',
    description: 'Casamento moderno no Palácio da Bolsa. Design minimalista com tema escuro e acentos dourados. Quiz personalizado sobre a história do casal.',
    image: '/portfolio/mariana-tiago.jpg',
    features: ['Tema escuro', 'Quiz pessoal', 'Timeline', 'Countdown'],
  },
  {
    couple: 'Catarina & João',
    location: 'Algarve',
    date: 'Maio 2024',
    description: 'Casamento na praia com paleta de cores suaves. Website bilingue (PT/EN) para convidados internacionais. Mapa de mesas com 25 mesas.',
    image: '/portfolio/catarina-joao.jpg',
    features: ['Bilingue', 'Mapa de mesas', 'Galeria ao vivo', 'Ementa'],
  },
  {
    couple: 'Sofia & Miguel',
    location: 'Lisboa',
    date: 'Outubro 2024',
    description: 'Casamento íntimo no Palácio de Queluz. Foco na história de amor do casal com secção narrativa extensa e galeria fotográfica curada.',
    image: '/portfolio/sofia-miguel.jpg',
    features: ['Love story', 'Galeria curada', 'RSVP', 'FAQ'],
  },
  {
    couple: 'Rita & Bruno',
    location: 'Douro',
    date: 'Agosto 2024',
    description: 'Casamento numa quinta vinícola no Douro. Ementa com harmonização de vinhos e dress code detalhado para o evento ao ar livre.',
    image: '/portfolio/rita-bruno.jpg',
    features: ['Ementa detalhada', 'Dress code', 'Convite animado', 'Countdown'],
  },
  {
    couple: 'Inês & Gonçalo',
    location: 'Comporta',
    date: 'Julho 2024',
    description: 'Casamento boho-chic na Comporta. Paleta de tons terrosos com tipografia orgânica. Mais de 200 convidados geriram RSVP pelo site.',
    image: '/portfolio/ines-goncalo.jpg',
    features: ['200+ RSVPs', 'Galeria ao vivo', 'Timeline', 'Mapa de mesas'],
  },
];
---

<Layout title="Portfólio — Nó Digital" description="Veja exemplos de websites de casamento que criámos para casais em Portugal.">
  <!-- Hero -->
  <section class="section-padding pt-32 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-gold-500 font-medium text-sm uppercase tracking-wide mb-2">Portfólio</p>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-olive-900 mb-4">
        Casamentos que já encantámos
      </h1>
      <p class="text-olive-600 text-lg leading-relaxed">
        Cada projeto é único, desenhado à medida do casal e do seu dia especial.
      </p>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="section-padding pt-8">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project) => (
        <article class="bg-white rounded-2xl overflow-hidden shadow-sm border border-beige-200 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group">
          <!-- Image placeholder -->
          <div class="h-52 bg-gradient-to-br from-olive-100 to-beige-200 flex items-center justify-center relative overflow-hidden">
            <span class="font-script text-4xl text-gold-400 group-hover:scale-110 transition-transform duration-500">
              {project.couple}
            </span>
          </div>

          <div class="p-6">
            <div class="flex items-center gap-2 text-sm text-olive-500 mb-2">
              <span>📍 {project.location}</span>
              <span>•</span>
              <span>{project.date}</span>
            </div>
            <h3 class="font-serif text-xl font-semibold text-olive-800 mb-2">{project.couple}</h3>
            <p class="text-olive-600 text-sm leading-relaxed mb-4">{project.description}</p>
            <div class="flex flex-wrap gap-2">
              {project.features.map((f) => (
                <span class="text-xs px-3 py-1 rounded-full bg-beige-100 text-olive-600 border border-beige-200">
                  {f}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-olive-900 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-serif text-3xl font-bold text-white mb-4">O vosso pode ser o próximo</h2>
      <p class="text-beige-300 mb-8">Vamos conversar sobre o que imaginam para o vosso dia.</p>
      <a href="/contacto" class="btn-primary bg-gold-400 hover:bg-gold-500 text-lg px-10 py-4">
        Começar Agora →
      </a>
    </div>
  </section>
</Layout>
