---
const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: `${base}`, label: 'Início' },
  { href: `${base}funcionalidades`, label: 'Funcionalidades' },
  { href: `${base}portfolio`, label: 'Portfólio' },
  { href: `${base}precos`, label: 'Preços' },
  { href: `${base}contacto`, label: 'Contacto' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-beige-50/90 backdrop-blur-md border-b border-beige-200/50">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href={base} class="flex items-center gap-2">
      <span class="font-script text-2xl text-gold-500">Nó</span>
      <span class="font-serif text-lg font-semibold text-olive-800">Digital</span>
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm font-medium text-olive-700 hover:text-gold-500 transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA -->
    <a href={`${base}contacto`} class="hidden md:inline-flex btn-primary text-sm px-6 py-2.5">
      Pedir Orçamento
    </a>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-olive-700"
      aria-label="Abrir menu"
      type="button"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden bg-beige-50 border-b border-beige-200 px-4 pb-4">
    <ul class="space-y-3">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="block py-2 text-olive-700 hover:text-gold-500 font-medium">
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href={`${base}contacto`} class="btn-primary w-full text-center text-sm mt-2">
          Pedir Orçamento
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
