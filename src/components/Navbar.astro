---

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Início', icon: '🏠' },
  { href: '/funcionalidades', label: 'Funcionalidades', icon: '✨' },
  { href: '/precos', label: 'Planos', icon: '💎' },
  { href: '/sobre', label: 'Sobre', icon: '👋' },
  { href: '/contacto', label: 'Contacto', icon: '💌' },
];

function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath.startsWith(href);
}
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-beige-50/90 backdrop-blur-md border-b border-beige-200/50">
  <!-- Decorative top gold line -->
  <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-gold-400 to-transparent opacity-60"></div>
  
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between py-3" aria-label="Navegação principal">
    <!-- Logo with floral decoration -->
    <a href="/" class="flex items-center gap-2 group relative" aria-label="NoDigital, Página inicial">
      <span class="absolute -top-1 -left-2 text-xs opacity-0 group-hover:opacity-60 transition-all duration-500 group-hover:-translate-y-1">🌸</span>
      <span class="font-script text-3xl text-gold-500 group-hover:text-gold-600 transition-all duration-300 group-hover:scale-110">No</span>
      <span class="font-serif text-lg font-semibold text-olive-800 group-hover:text-olive-900 transition-colors">Digital</span>
      <span class="absolute -bottom-1 -right-2 text-xs opacity-0 group-hover:opacity-60 transition-all duration-500 group-hover:translate-y-1">✨</span>
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`text-sm font-medium transition-all duration-300 relative px-4 py-2 rounded-full group ${
              isActive(link.href)
                ? 'text-gold-600 bg-gold-50'
                : 'text-olive-700 hover:text-gold-500 hover:bg-gold-50/50'
            }`}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            <span class="relative z-10">{link.label}</span>
            {isActive(link.href) && (
              <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-6 h-1 bg-gold-400 rounded-full" />
            )}
            <span class="absolute -top-1 left-1/2 -translate-x-1/2 text-xs opacity-0 group-hover:opacity-100 group-hover:-translate-y-2 transition-all duration-300">{link.icon}</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA with flower -->
    <div class="hidden md:block relative group">
      <svg class="absolute -top-2 -right-2 w-5 h-5 text-gold-300 opacity-0 group-hover:opacity-80 group-hover:rotate-12 transition-all duration-400" viewBox="0 0 20 20" fill="currentColor">
        <circle cx="10" cy="4" r="2.5"/><circle cx="14" cy="8" r="2.5"/><circle cx="12" cy="13" r="2.5"/><circle cx="8" cy="13" r="2.5"/><circle cx="6" cy="8" r="2.5"/><circle cx="10" cy="8" r="2" fill="#a05614"/>
      </svg>
      <a href="/contacto" class="inline-flex items-center gap-2 bg-gradient-to-r from-gold-400 to-gold-500 hover:from-gold-500 hover:to-gold-600 text-white text-sm font-semibold px-6 py-2.5 rounded-full shadow-md hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300">
        Pedir Orçamento
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-olive-700 hover:text-gold-500 transition-colors rounded-full hover:bg-gold-50"
      aria-label="Abrir menu de navegação"
      aria-expanded="false"
      type="button"
    >
      <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden bg-beige-50/98 backdrop-blur-lg border-b border-beige-200 px-4 pb-6 pt-2" aria-label="Menu mobile">
    <ul class="space-y-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`flex items-center gap-3 py-3 px-4 rounded-xl font-medium transition-all duration-300 ${
              isActive(link.href)
                ? 'text-gold-600 bg-gold-50 shadow-sm'
                : 'text-olive-700 hover:text-gold-500 hover:bg-beige-100'
            }`}
          >
            <span class="text-lg">{link.icon}</span>
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-3">
        <a href="/contacto" class="flex items-center justify-center gap-2 bg-gradient-to-r from-gold-400 to-gold-500 text-white font-semibold w-full text-center text-sm py-3.5 rounded-full shadow-md">
          Pedir Orçamento
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const navbar = document.getElementById('navbar');

  // Mobile menu toggle
  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  // Navbar shrink on scroll with enhanced effects
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    if (currentScroll > 50) {
      navbar?.classList.add('shadow-lg', 'py-0');
      navbar?.classList.remove('border-b', 'border-beige-200/50');
      navbar?.classList.add('bg-beige-50/95');
    } else {
      navbar?.classList.remove('shadow-lg', 'py-0');
      navbar?.classList.add('border-b', 'border-beige-200/50');
      navbar?.classList.remove('bg-beige-50/95');
    }
    lastScroll = currentScroll;
  }, { passive: true });
</script>
