---
const currentYear = new Date().getFullYear();
---

<footer class="bg-olive-900 text-beige-200 relative overflow-hidden">
  <!-- Top floral vine decoration -->
  <div class="relative" aria-hidden="true">
    <svg class="w-full h-12 text-olive-800" preserveAspectRatio="none" viewBox="0 0 1200 50" fill="currentColor">
      <path d="M0,50 L0,30 Q200,0 400,25 Q600,50 800,20 Q1000,0 1200,30 L1200,50 Z"/>
    </svg>
    <!-- Flowers on top vine -->
    <svg class="absolute top-3 left-[20%] w-5 h-5 text-gold-400 bloom" viewBox="0 0 20 20" fill="currentColor">
      <circle cx="10" cy="5" r="2.5"/><circle cx="13" cy="8" r="2.5"/><circle cx="12" cy="13" r="2.5"/><circle cx="8" cy="13" r="2.5"/><circle cx="7" cy="8" r="2.5"/><circle cx="10" cy="9" r="2" fill="#a05614"/>
    </svg>
    <svg class="absolute top-5 left-[50%] w-4 h-4 text-gold-300 bloom" style="animation-delay: -1s;" viewBox="0 0 20 20" fill="currentColor">
      <circle cx="10" cy="5" r="2"/><circle cx="13" cy="8" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="8" cy="12" r="2"/><circle cx="7" cy="8" r="2"/><circle cx="10" cy="8" r="1.5" fill="#a05614"/>
    </svg>
    <svg class="absolute top-2 right-[25%] w-5 h-5 text-gold-400 bloom" style="animation-delay: -2s;" viewBox="0 0 20 20" fill="currentColor">
      <circle cx="10" cy="5" r="2.5"/><circle cx="13" cy="8" r="2.5"/><circle cx="12" cy="13" r="2.5"/><circle cx="8" cy="13" r="2.5"/><circle cx="7" cy="8" r="2.5"/><circle cx="10" cy="9" r="2" fill="#a05614"/>
    </svg>
  </div>

  <!-- Background decorations -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-[20%] right-[5%] text-3xl opacity-5 float-slow">🌸</div>
    <div class="absolute bottom-[30%] left-[5%] text-2xl opacity-5 float">🌹</div>
    <svg class="absolute bottom-10 right-10 w-32 h-32 opacity-[0.03]" viewBox="0 0 100 100" fill="#d99b1a">
      <circle cx="50" cy="25" r="15"/><circle cx="70" cy="45" r="15"/><circle cx="60" cy="70" r="15"/><circle cx="35" cy="70" r="15"/><circle cx="30" cy="45" r="15"/><circle cx="50" cy="48" r="12"/>
    </svg>
  </div>

  <div class="py-16 px-4 sm:px-6 lg:px-8 relative">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-4 gap-10 mb-12">
        <!-- Brand -->
        <div class="md:col-span-2">
          <div class="flex items-center gap-2 mb-4 group">
            <span class="font-script text-4xl text-gold-400 group-hover:scale-110 transition-transform">No</span>
            <span class="font-serif text-xl font-semibold text-white">Digital</span>
            <span class="text-xl ml-1 opacity-0 group-hover:opacity-100 transition-opacity">💐</span>
          </div>
          <p class="text-beige-300 max-w-sm leading-relaxed mb-6">
            Websites de casamento premium — elegantes, interativos e personalizáveis. 
            Feitos com atenção ao detalhe, em Portugal. 🇵🇹
          </p>
        </div>

        <!-- Links -->
        <div>
          <h4 class="font-semibold text-white mb-4 text-sm uppercase tracking-wide flex items-center gap-2">
            <span class="text-gold-400">🌿</span> Navegação
          </h4>
          <ul class="space-y-3 text-sm">
            <li><a href="/" class="hover:text-gold-400 transition-all duration-300 hover:translate-x-1 inline-block">→ Início</a></li>
            <li><a href="/funcionalidades" class="hover:text-gold-400 transition-all duration-300 hover:translate-x-1 inline-block">→ Funcionalidades</a></li>
            <li><a href="/precos" class="hover:text-gold-400 transition-all duration-300 hover:translate-x-1 inline-block">→ Preços</a></li>
            <li><a href="/sobre" class="hover:text-gold-400 transition-all duration-300 hover:translate-x-1 inline-block">→ Sobre</a></li>
            <li><a href="/contacto" class="hover:text-gold-400 transition-all duration-300 hover:translate-x-1 inline-block">→ Contacto</a></li>
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <h4 class="font-semibold text-white mb-4 text-sm uppercase tracking-wide flex items-center gap-2">
            <span class="text-gold-400">💌</span> Contacto
          </h4>
          <ul class="space-y-3 text-sm">
            <li>
              <a href="mailto:hugosilva2320@gmail.com" class="hover:text-gold-400 transition-all duration-300 hover:translate-x-1 inline-flex items-center gap-2">
                📧 hugosilva2320@gmail.com
              </a>
            </li>
            <li>
              <a href="https://wa.me/351911820236" class="hover:text-gold-400 transition-all duration-300 hover:translate-x-1 inline-flex items-center gap-2">
                📱 +351 911 820 236
              </a>
            </li>
            <li class="flex items-center gap-2">📍 Porto, Portugal</li>
          </ul>
        </div>
      </div>

      <!-- Decorative divider -->
      <div class="flex items-center justify-center gap-4 mb-8">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent to-olive-700"></div>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="#d99b1a" class="opacity-40">
          <circle cx="10" cy="5" r="2.5"/><circle cx="13" cy="8" r="2.5"/><circle cx="12" cy="13" r="2.5"/><circle cx="8" cy="13" r="2.5"/><circle cx="7" cy="8" r="2.5"/><circle cx="10" cy="9" r="2" fill="#a05614"/>
        </svg>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent to-olive-700"></div>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-beige-400">
        <p class="flex items-center gap-2">
          © {currentYear} NoDigital. Feito com <span class="text-red-400 heartbeat text-base">❤️</span> no Porto.
        </p>
        <div class="flex flex-wrap gap-6">
          <a href="/privacidade" class="hover:text-gold-400 transition-colors">Privacidade</a>
          <a href="/cookies" class="hover:text-gold-400 transition-colors">Cookies</a>
          <a href="/termos" class="hover:text-gold-400 transition-colors">Termos</a>
        </div>
      </div>
    </div>
  </div>
</footer>
