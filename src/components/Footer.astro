---
const currentYear = new Date().getFullYear();
---

<footer class="bg-olive-900 text-beige-200 py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid md:grid-cols-4 gap-10 mb-12">
      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <span class="font-script text-3xl text-gold-400">Nó</span>
          <span class="font-serif text-xl font-semibold text-white">Digital</span>
        </div>
        <p class="text-beige-300 max-w-sm leading-relaxed">
          Criamos websites de casamento premium que encantam os vossos convidados. 
          Feito em Portugal, com paixão por cada detalhe.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h4 class="font-semibold text-white mb-4">Navegação</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-gold-400 transition-colors">Início</a></li>
          <li><a href="/funcionalidades" class="hover:text-gold-400 transition-colors">Funcionalidades</a></li>
          <li><a href="/portfolio" class="hover:text-gold-400 transition-colors">Portfólio</a></li>
          <li><a href="/precos" class="hover:text-gold-400 transition-colors">Preços</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-semibold text-white mb-4">Contacto</h4>
        <ul class="space-y-2 text-sm">
          <li>📧 ola@nodigital.pt</li>
          <li>📱 +351 912 345 678</li>
          <li>📍 Lisboa, Portugal</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-olive-700 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-beige-400">
      <p>© {currentYear} Nó Digital. Todos os direitos reservados.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-gold-400 transition-colors">Instagram</a>
        <a href="#" class="hover:text-gold-400 transition-colors">Pinterest</a>
        <a href="#" class="hover:text-gold-400 transition-colors">WhatsApp</a>
      </div>
    </div>
  </div>
</footer>
